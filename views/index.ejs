<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Atritek</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="min-h-screen text-white antialiased">
  <%- include('partials/header') %>

  <main class="max-w-4xl mx-auto px-6 py-24">
  <section class="space-y-10">

    <!-- Hero Block -->
    <div class="backdrop-glass no-hover text-center py-10">
    <h1 class="text-4xl font-extrabold tracking-tight text-accent drop-shadow-lg">Atritek</h1>
      <p class="mt-3 text-gray text-lg">Custom PC Builds • Console Repairs • 3D Printing • Hall Effect Mods</p>
    </div>

    <!-- Service Cards -->
    <div class="flex flex-col gap-10 mt-12">

      <!-- PC Builds -->
      <a href="/pc-build" class="card card-wide group" style="background-image:url('/img/pc.jpg')">
        <div class="card-overlay"></div>
        <div class="card-content">
          <h2 class="text-3xl font-bold text-accent mb-2">PC Builds</h2>
          <p class="text-gray text-base leading-relaxed">Custom rigs for gaming, productivity, or creativity. Let’s build your dream machine — clean, powerful, and efficient.</p>
        </div>
      </a>

      <!-- Console Fixing -->
      <a href="/console-fix" class="card card-wide group" style="background-image:url('/img/console.jpg')">
        <div class="card-overlay"></div>
        <div class="card-content">
          <h2 class="text-3xl font-bold text-accent mb-2">Console & Controller Fixing</h2>
          <p class="text-gray text-base leading-relaxed">Breathe new life into your console or controller — hall effect sensor mods and honest repairs done right.</p>
        </div>
      </a>

      <!-- 3D Printing -->
      <a href="/3d-print" class="card card-wide group" style="background-image:url('/img/print.jpg')">
        <div class="card-overlay"></div>
        <div class="card-content">
          <h2 class="text-3xl font-bold text-accent mb-2">3D Printing</h2>
          <p class="text-gray text-base leading-relaxed">Upload your model and we’ll bring it to life with speed and quality</p>
        </div>
      </a>

    </div>
  </section>
</main>

  <%- include('partials/footer') %>
</body>
</html>
